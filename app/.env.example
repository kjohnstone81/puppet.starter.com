# Copy to .env.local for local development. In Cloud Run these are set by Terraform,
# with the three secret values sourced from Secret Manager.

# GCP
GOOGLE_CLOUD_PROJECT=my-gcp-project
FIRESTORE_DATABASE_ID=(default)
ASSETS_BUCKET=my-gcp-project-booking-assets

# Optional. Only set this when the site is served from a fixed URL you control
# (a custom domain). Left unset, the OAuth redirect URI is derived from the
# request's own origin, so the Cloud Run URL works without configuration.
# PUBLIC_BASE_URL=https://booking.example.com

# Google OAuth client (Web application) — the same client is used for admin
# sign-in and for Calendar access.
GOOGLE_OAUTH_CLIENT_ID=xxxxx.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=GOCSPX-xxxxx

# Only this Google account may sign in to /admin.
ADMIN_EMAIL=owner@example.com

# Random 32+ byte string used to sign session cookies:
#   openssl rand -base64 48
SESSION_SECRET=change-me-to-a-long-random-string

# Anthropic API key — powers logo-driven theme generation.
ANTHROPIC_API_KEY=sk-ant-xxxxx
